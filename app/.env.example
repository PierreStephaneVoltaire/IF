# Copy to .env and set values for the services you use.

INTERNAL_API_TOKEN=replace-with-a-random-secret
IF_API_URL=http://localhost:8000
IF_JOB_DB=./data/conversations/execution.sqlite3
IF_ARTIFACT_DIR=./data/artifacts
IF_WORKSPACE_BASE=/app/src/data/conversations

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Codex uses the local ChatGPT subscription login.
SUGGESTION_MODEL=gpt-5.6-sol
CONDENSER_MODEL=gpt-5.6-luna
HEARTBEAT_FALLBACK_MODEL=gpt-5.6-sol
REFLECTION_MODEL=gpt-5.6-sol
DIARY_SIGNAL_MODEL=gpt-5.6-luna
RESEARCH_AGENT_MODEL=gpt-5.6-sol

AWS_REGION=ca-central-1
IF_CORE_TABLE_NAME=if-core
IF_EXECUTION_REGISTRY_TABLE_NAME=if-agent-execution-registry
IF_HEALTH_TABLE_NAME=if-health
IF_SESSIONS_TABLE_NAME=if-sessions
IF_FINANCE_TABLE_NAME=if-finance
IF_DIARY_ENTRIES_TABLE_NAME=if-diary-entries
IF_DIARY_SIGNALS_TABLE_NAME=if-diary-signals
IF_PROPOSALS_TABLE_NAME=if-proposals
IF_MODELS_TABLE_NAME=if-models
IF_WEBHOOKS_TABLE_NAME=if-webhooks
IF_USER_PK=operator
IF_OPERATOR_DISCORD_ID=400750817382236160
IF_CODEX_HOST_URL=http://if-codex-worker:8001
IF_HOST_STATE_DIR=/work/host

GOOGLE_SHEETS_CREDENTIALS=
ALPHAVANTAGE_API_KEY=
